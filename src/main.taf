<taf-app:container:ghcr.io/taffish/vg:1.77.0-r1$@[docker/podman: $(if test "${TAFFISH_VG_GUI:-0}" = 1; then taf_vg_port="${TAFFISH_VG_GUI_PORT:-3000}"; case "$taf_vg_port" in (""|*[!0-9\\]*) printf -- "--taffish-vg-invalid-gui-port";; (*) if test "$taf_vg_port" -ge 1024 && test "$taf_vg_port" -le 65535; then printf -- "--publish=127.0.0.1:%s:3000 --env=TAFFISH_VG_GUI_BRIDGE=1 --env=TAFFISH_VG_GUI_INTERNAL_PORT=3000 --env=TAFFISH_VG_GUI_PORT=%s" "$taf_vg_port" "$taf_vg_port"; else printf -- "--taffish-vg-invalid-gui-port"; fi;; esac; fi) $(taf_vg_check() { for taf_vg_member in graph.gfa.gz resource.json SHA256SUMS READY; do test -f "$taf_vg_root/$taf_vg_member" && test ! -L "$taf_vg_root/$taf_vg_member" || return 1; done; for taf_vg_member in "$taf_vg_root"/* "$taf_vg_root"/.[!.\]* "$taf_vg_root"/..?*; do if test -e "$taf_vg_member" || test -L "$taf_vg_member"; then case "${taf_vg_member##*/}" in (graph.gfa.gz|resource.json|SHA256SUMS|READY) :;; (*) return 1;; esac; fi; done; awk 'NF != 2 || length($1) != 64 || $1 ~ /[^a-f0-9\]/ { bad=1 } $2 == "graph.gfa.gz" { g++ } $2 == "resource.json" { r++ } END { exit (bad || NR != 2 || g != 1 || r != 1) }' "$taf_vg_root/SHA256SUMS" || return 1; taf_vg_sum="$(taf_vg_hash "$taf_vg_root/SHA256SUMS")"; test "${taf_vg_sum%% *}" = "$(cat "$taf_vg_root/READY")" || return 1; grep -Fx '  "schema": "taffish.vg.resource.v1",' "$taf_vg_root/resource.json" >/dev/null || return 1; taf_vg_actual_id="$(sed -n 's/^  "resource": "\([A-Za-z0-9\][A-Za-z0-9_.-\]*\)",$/\1/p' "$taf_vg_root/resource.json")"; test -n "$taf_vg_actual_id" || return 1; case "$taf_vg_actual_id" in (*[!A-Za-z0-9_.-\]*) return 1;; esac; if test -z "${TAFFISH_VG_RESOURCE_PATH:-}" && test "$taf_vg_actual_id" != "$taf_vg_id"; then printf >&2 'taf-vg: resource identity mismatch: requested=%s actual=%s\n' "$taf_vg_id" "$taf_vg_actual_id"; return 1; fi; taf_vg_expected_sha=''; case "$taf_vg_actual_id" in (hprc-v1.0-mc-grch38-gfa) taf_vg_expected_sha=1619a259e21172328890ab41f39ac993114c3397d18802bbac5ef1e6cf991cdf;; (hprc-v1.0-mc-chm13-gfa) taf_vg_expected_sha=555c940784c012232f9541d732619d247c9eb8bd0dd3944f36eb1d4e717333b7;; (local-?*) :;; (*) return 1;; esac; if test -n "$taf_vg_expected_sha"; then grep -Fx "$taf_vg_expected_sha  graph.gfa.gz" "$taf_vg_root/SHA256SUMS" >/dev/null || return 1; fi; (cd "$taf_vg_root" && if command -v sha256sum >/dev/null 2>&1; then sha256sum -c SHA256SUMS; else shasum -a 256 -c SHA256SUMS; fi) >/dev/null 2>&1; }; taf_vg_hash() { if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1"; else shasum -a 256 "$1"; fi; }; taf_vg_emit() { taf_vg_path="$(cd "$1" 2>/dev/null && pwd -P)"; taf_vg_bad="$(printf '%s' "$taf_vg_path" | tr -d 'A-Za-z0-9_./+-')"; if test -z "$taf_vg_path" || test -n "$taf_vg_bad"; then printf >&2 'taf-vg: resource bind path must use letters, digits, _, ., /, + or -; use a safe physical path\n'; printf -- '--taffish-vg-invalid-resource'; return; fi; printf -- '--volume=%s:%s' "$taf_vg_path" "$2"; }; if test -n "${TAFFISH_VG_RESOURCE_INSTALL_ROOT:-}"; then taf_vg_emit "$TAFFISH_VG_RESOURCE_INSTALL_ROOT" /resource-install; exit 0; fi; if test "${TAFFISH_VG_RESOURCE_AUTO_MOUNT:-1}" = 0; then exit 0; fi; taf_vg_root="${TAFFISH_VG_RESOURCE_PATH:-}"; taf_vg_id="${TAFFISH_VG_RESOURCE_ID:-}"; if test -z "$taf_vg_root" && test -n "$taf_vg_id"; then taf_vg_bad="$(printf '%s' "$taf_vg_id" | tr -d 'A-Za-z0-9_.-')"; if test -n "$taf_vg_bad" || test "${taf_vg_id#.}" != "$taf_vg_id"; then printf -- '--taffish-vg-invalid-resource'; exit 0; fi; for taf_vg_candidate in "${TAFFISH_USER_HOME:-${HOME:-}/.local/share/taffish}/resources/vg/$taf_vg_id" "/usr/local/share/taffish/resources/vg/$taf_vg_id" "/opt/taffish/resources/vg/$taf_vg_id"; do if test -e "$taf_vg_candidate" || test -L "$taf_vg_candidate"; then taf_vg_root="$taf_vg_candidate"; break; fi; done; fi; if test -n "$taf_vg_root" || test -n "$taf_vg_id"; then if taf_vg_check; then taf_vg_emit "$taf_vg_root" /vg-resource:ro; else printf >&2 'taf-vg: se