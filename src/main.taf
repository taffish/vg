<shell>
# Only runtime policy and verified resource discovery live in the wrapper.
taf_vg_gui_args() {
    case "${TAFFISH_VG_GUI:-0}" in
        0) return 0 ;;
        1) ;;
        *) printf >&2 'taf-vg: GUI must be 0 or 1\n'; printf -- '--taffish-vg-invalid-gui'; return 0 ;;
    esac
    taf_vg_port="${TAFFISH_VG_GUI_PORT:-3000}"
    case "$taf_vg_port" in
        ''|*[!0-9]*) printf -- '--taffish-vg-invalid-gui-port'; return 0 ;;
    esac
    if ! test "$taf_vg_port" -ge 1024 || ! test "$taf_vg_port" -le 65535; then
        printf -- '--taffish-vg-invalid-gui-port'; return 0
    fi
    if test "$1" = apptainer; then
        printf -- '--env=TAFFISH_VG_GUI_PORT=%s' "$taf_vg_port"
    else
        printf -- '--publish=127.0.0.1:%s:3000 --env=TAFFISH_VG_GUI_BRIDGE=1 --env=TAFFISH_VG_GUI_INTERNAL_PORT=3000 --env=TAFFISH_VG_GUI_PORT=%s' "$taf_vg_port" "$taf_vg_port"
    fi
}
taf_vg_mount() {
    taf_vg_backend="$1"
    taf_vg_target=/vg-resource:ro
    taf_vg_id="${TAFFISH_VG_RESOURCE_ID:-}"
    if test "${TAFFISH_VG_RESOURCE_INSTALL_ROOT+x}" = x; then
        taf_vg_root="$TAFFISH_VG_RESOURCE_INSTALL_ROOT"
        taf_vg_target=/resource-install
    else
        case "${TAFFISH_VG_RESOURCE_AUTO_MOUNT:-1}" in
            0) return 0 ;;
            1) ;;
            *) printf >&2 'taf-vg: RESOURCE_AUTO_MOUNT must be 0 or 1\n'; printf -- '--taffish-vg-invalid-resource'; return 0 ;;
        esac
        taf_vg_root="${TAFFISH_VG_RESOURCE_PATH:-}"
        if test "${TAFFISH_VG_RESOURCE_PATH+x}" != x; then
            if test -z "$taf_vg_id"; then return 0; fi
            case "$taf_vg_id" in
                [A-Za-z0-9]*) ;;
                *) printf -- '--taffish-vg-invalid-resource'; return 0 ;;
            esac
            case "$taf_vg_id" in *[!A-Za-z0-9_.-]*) printf -- '--taffish-vg-invalid-resource'; return 0 ;; esac
            for taf_vg_candidate in "${TAFFISH_USER_HOME:-${HOME}/.local/share/taffish}/resources/vg/$taf_vg_id" "/usr/local/share/taffish/resources/vg/$taf_vg_id" "/opt/taffish/resources/vg/$taf_vg_id"; do
                if test -e "$taf_vg_candidate" || test -L "$taf_vg_candidate"; then
                    taf_vg_root="$taf_vg_candidate"; break
                fi
            done
        fi
    fi
    if ! test -d "$taf_vg_root"; then
        printf >&2 'taf-vg: selected resource/install root missing or invalid\n'
        printf -- '--taffish-vg-invalid-resource'; return 0
    fi
    taf_vg_root="$(CDPATH= cd "$taf_vg_root" && pwd -P)" || {
        printf -- '--taffish-vg-invalid-resource'; return 0;
    }
    case "$taf_vg_root" in *:*|*,*)
        printf >&2 'taf-vg: bind path cannot contain colon or comma\n'
        printf -- '--taffish-vg-invalid-resource'; return 0 ;;
    esac
    if test "$taf_vg_target" = /vg-resource:ro; then
        if ! command -v python3 >/dev/null 2>&1; then
            printf >&2 'taf-vg: automatic validation requires host Python 3; disable discovery, verify inside the container and bind manually\n'
            printf -- '--taffish-vg-invalid-resource'; return 0
        fi
        if test -n "$taf_vg_id"; then
            python3 -I -B "::*LOADDIR*::/resource_validation.py" "$taf_vg_root" "$taf_vg_id"
        else
            python3 -I -B "::*LOADDIR*::/resource_validation.py" "$taf_vg_root"
        fi
        if test "$?" != 0; then
            printf >&2 'taf-vg: resource integrity/identity failed; choose a verified RESOURCE_PATH or disable discovery for repair\n'
            printf -- '--taffish-vg-invalid-resource'; return 0
        fi
    fi
    if test "$taf_vg_backend" = apptainer; then
        printf -- '--bind=%s:%s' "$taf_vg_root" "$taf_vg_target"
    else
        printf -- '--volume=%s:%s' "$taf_vg_root" "$taf_vg_target"
    fi
}
# Prepare the optional bind once. Quoted conditional expansion preserves spaces
# without passing an empty positional argument to the container engine.
taf_vg_mount_args="$(taf_vg_mount docker)"
case "$taf_vg_mount_args" in --taffish-vg-invalid-*) exit 1 ;; esac
taf_vg_apptainer_mount_args=
if test -n "$taf_vg_mount_args"; then
    taf_vg_apptainer_mount_args="--bind=${taf_vg_mount_args#--volume=}"
fi
<taf-app:container:ghcr.io/taffish/vg:1.78.0-r1$@[docker/podman: --init $(taf_vg_gui_args docker) ${taf_vg_mount_args:+"$taf_vg_mount_args"}][docker: --user=$(id -u):$(id -g)][podman: --userns=keep-id --user=$(id -u):$(id -g)][apptainer: $(taf_vg_gui_args apptainer) ${taf_vg_apptainer_mount_args:+"$taf_vg_apptainer_mount_args"}]>
vg ::*ARGV*::
