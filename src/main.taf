ase "$taf_vg_actual_id" in (hprc-v1.0-mc-grch38-gfa) taf_vg_expected_sha=1619a259e21172328890ab41f39ac993114c3397d18802bbac5ef1e6cf991cdf;; (hprc-v1.0-mc-chm13-gfa) taf_vg_expected_sha=555c940784c012232f9541d732619d247c9eb8bd0dd3944f36eb1d4e717333b7;; (local-?*) :;; (*) return 1;; esac; if test -n "$taf_vg_expected_sha"; then grep -Fx "$taf_vg_expected_sha  graph.gfa.gz" "$taf_vg_root/SHA256SUMS" >/dev/null || return 1; fi; (cd "$taf_vg_root" && if command -v sha256sum >/dev/null 2>&1; then sha256sum -c SHA256SUMS; else shasum -a 256 -c SHA256SUMS; fi) >/dev/null 2>&1; }; taf_vg_hash() { if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1"; else shasum -a 256 "$1"; fi; }; taf_vg_emit() { taf_vg_path="$(cd "$1" 2>/dev/null && pwd -P)"; taf_vg_bad="$(printf '%s' "$taf_vg_path" | tr -d 'A-Za-z0-9_./+-')"; if test -z "$taf_vg_path" || test -n "$taf_vg_bad"; then printf >&2 'taf-vg: resource bind path must use letters, digits, _, ., /, + or -; use a safe physical path\n'; printf -- '--taffish-vg-invalid-resource'; return; fi; printf -- '--bind=%s:%s' "$taf_vg_path" "$2"; }; if test -n "${TAFFISH_VG_RESOURCE_INSTALL_ROOT:-}"; then taf_vg_emit "$TAFFISH_VG_RESOURCE_INSTALL_ROOT" /resource-install; exit 0; fi; if test "${TAFFISH_VG_RESOURCE_AUTO_MOUNT:-1}" = 0; then exit 0; fi; taf_vg_root="${TAFFISH_VG_RESOURCE_PATH:-}"; taf_vg_id="${TAFFISH_VG_RESOURCE_ID:-}"; if test -z "$taf_vg_root" && test -n "$taf_vg_id"; then taf_vg_bad="$(printf '%s' "$taf_vg_id" | tr -d 'A-Za-z0-9_.-')"; if test -n "$taf_vg_bad" || test "${taf_vg_id#.}" != "$taf_vg_id"; then printf -- '--taffish-vg-invalid-resource'; exit 0; fi; for taf_vg_candidate in "${TAFFISH_USER_HOME:-${HOME:-}/.local/share/taffish}/resources/vg/$taf_vg_id" "/usr/local/share/taffish/resources/vg/$taf_vg_id" "/opt/taffish/resources/vg/$taf_vg_id"; do if test -e "$taf_vg_candidate" || test -L "$taf_vg_candidate"; then taf_vg_root="$taf_vg_candidate"; break; fi; done; fi; if test -n "$taf_vg_root" || test -n "$taf_vg_id