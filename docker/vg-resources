#!/usr/bin/env python3
"""Explicit GFA acquisition with resumable bytes and immutable atomic promotion."""
import argparse
import ctypes
import fcntl
import json
import os
from pathlib import Path
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import time

sys.dont_write_bytecode = True
code = Path(__file__).resolve().parent
if not (code / 'resource_validation.py').is_file():
    code = code.parent / 'src'
sys.path.insert(0, str(code))
from resource_validation import CATALOG, SCHEMA, digest, header, verify

class Interrupted(Exception):
    def __init__(self, signum):
        self.signum = signum

def interrupt(signum, frame):
    for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, signal.SIG_IGN)
    raise Interrupted(signum)

SIGNALS = {signal.SIGINT, signal.SIGTERM, signal.SIGHUP}

def download(command):
    # Register the owned child before delivery of a pending interrupt.
    previous = signal.pthread_sigmask(signal.SIG_BLOCK, SIGNALS)
    child = None
    try:
        try:
            child = subprocess.Popen(command, start_new_session=True,
                preexec_fn=lambda: signal.pthread_sigmask(signal.SIG_SETMASK, previous))
        finally:
            signal.pthread_sigmask(signal.SIG_SETMASK, previous)
        rc = child.wait()
        if rc:
            raise ValueError('download failed exit=' + str(rc) + '; partial retained')
    finally:
        if child is not None and child.poll() is None:
            child.terminate()
            try:
                child.wait(timeout=5)
            except subprocess.TimeoutExpired:
                child.kill()
                child.wait()

def promote(stage, target):
    # Linux no-replace rename also refuses an empty directory created in a race.
    libc = ctypes.CDLL(None, use_errno=True)
    if libc.renameat2(-100, os.fsencode(stage), -100, os.fsencode(target), 1):
        err = ctypes.get_errno()
        raise OSError(err, os.strerror(err), str(target))

def install(a):
    rid = a.resource
    if not re.fullmatch('[A-Za-z0-9][A-Za-z0-9_.-]*', rid):
        raise ValueError('choose a safe explicit resource ID')
    source = Path(a.source).resolve(strict=True) if a.source else None
    item = CATALOG.get(rid)
    if item is None:
        if (not rid.startswith('local-') or len(rid) <= 6 or source is None or
                not a.assembly or not a.license_note or
                not re.fullmatch('[a-f0-9]{64}', a.sha256 or '')):
            raise ValueError('local-* requires --source, --sha256, --assembly, --license-note')
        item = dict(kind='gfa-gzip', assembly=a.assembly, bytes=source.stat().st_size,
                    sha256=a.sha256, license=a.license_note, origin=source.name)
    root = Path(a.resource_root).resolve()
    target = root / rid
    required = 2 * item['bytes'] + 67108864
    if a.dry_run:
        print(json.dumps(dict(resource=rid, source=item, target=str(target),
                              required_free_bytes=required, network_opt_in=a.allow_network), indent=2))
        return
    if target.exists() or target.is_symlink():
        if verify(target, rid)['source'] != item:
            raise ValueError('existing immutable source differs; choose a new ID')
        print('already installed; no download or writes')
        return
    if source is None and not a.allow_network:
        raise ValueError('network disabled: provide --source or explicitly use --allow-network')
    if not root.is_dir():
        raise ValueError('--resource-root must exist as an actual writable host-bound directory')
    # Keep legacy locks for diagnosis; never guess whether an old owner is alive.
    legacy = root / ('.' + rid + '.lock')
    if legacy.exists() or legacy.is_symlink():
        raise ValueError('legacy lock exists; inspect its owner before recovery: ' + str(legacy))
    fd = os.open(root / '.vg-resources.lock', os.O_WRONLY | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, 'w') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise ValueError('resource root locked; retry after installer finishes') from None
        if target.exists() or target.is_symlink():
            if verify(target, rid)['source'] != item:
                raise ValueError('existing immutable source differs')
            print('already installed; no download or writes')
            return
        if shutil.disk_usage(root).free < required:
            raise ValueError('insufficient free bytes: need ' + str(required))
        if source is None:
            cache = root / '.downloads'
            if cache.is_symlink():
                raise ValueError('cache symlink refused')
            cache.mkdir(mode=0o700, exist_ok=True)
            if cache.stat().st_uid != os.getuid() or cache.stat().st_mode & 0o077:
                raise ValueError('cache must be owned by installer and mode 0700')
            source = cache / (item['sha256'] + '.part')
            if source.is_symlink() or (source.exists() and not source.is_file()):
                raise ValueError('invalid cache member')
            if not source.exists() or source.stat().st_size < item['bytes']:
                print('downloading explicit member ' + rid + '; resume enabled', flush=True)
                download(['curl', '--fail', '--location', '--proto', '=https', '--proto-redir', '=https',
                    '--retry', '3', '--connect-timeout', '30', '--max-time', '21600',
                    '--speed-time', '60', '--speed-limit', '1024',
                    '--continue-at', '-', '--output', str(source), item['url']])
        if not source.is_file() or source.stat().st_size != item['bytes'] or digest(source) != item['sha256']:
            raise ValueError('size/checksum mismatch; no promotion, retained partial for diagnosis')
        header(source)
        stage = None
        try:
            previous = signal.pthread_sigmask(signal.SIG_BLOCK, SIGNALS)
            try:
                stage = Path(tempfile.mkdtemp(prefix='.' + rid + '.stage-', dir=root))
            finally:
                signal.pthread_sigmask(signal.SIG_SETMASK, previous)
            shutil.copyfile(source, stage / 'graph.gfa.gz')
            (stage / 'resource.json').write_text(json.dumps(dict(schema=SCHEMA, resource=rid, source=item,
                created_utc=time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime()), uid=os.getuid()),
                sort_keys=True, indent=2) + '\n')
            (stage / 'SHA256SUMS').write_text(''.join(digest(stage / n) + '  ' + n + '\n'
                                                    for n in ['graph.gfa.gz', 'resource.json']))
            (stage / 'READY').write_text(digest(stage / 'SHA256SUMS') + '\n')
            for path in stage.iterdir():
                path.chmod(0o644)
            verify(stage, rid)
            stage.chmod(0o755)
            promote(stage, target)
            stage = None
            print('installed resource=' + rid + ' root=' + str(target), flush=True)
        finally:
            # The exact owned stage path never becomes the installed target path.
            if stage is not None and stage.exists():
                shutil.rmtree(stage)

def main():
    p = argparse.ArgumentParser(description='Fixed shared GFA members; explicit download/import, never automatic analysis downloads.')
    sub = p.add_subparsers(dest='command', required=True)
    sub.add_parser('list', help='offline catalog; no default member and no whole-family download')
    v = sub.add_parser('verify', help='offline full SHA256/inventory and GFA-type check')
    v.add_argument('root')
    v.add_argument('--expected-resource')
    i = sub.add_parser('install', help='atomic resumable install to actual writable host bind')
    i.add_argument('--resource', required=True)
    i.add_argument('--resource-root', required=True)
    i.add_argument('--source')
    i.add_argument('--sha256')
    i.add_argument('--assembly')
    i.add_argument('--license-note')
    i.add_argument('--allow-network', action='store_true', help='explicitly permit HTTPS acquisition of selected catalog bytes')
    i.add_argument('--dry-run', action='store_true')
    a = p.parse_args()
    os.umask(0o022)
    if a.command == 'list':
        print(json.dumps(CATALOG, indent=2))
    elif a.command == 'verify':
        receipt = verify(Path(a.root), a.expected_resource)
        print('verified resource=' + receipt['resource'])
    else:
        install(a)

if __name__ == '__main__':
    try:
        for sig in SIGNALS:
            signal.signal(sig, interrupt)
        main()
    except Interrupted as error:
        print('vg-resources: stopping: ' + signal.Signals(error.signum).name +
              '; old members unchanged; download partial retained', file=sys.stderr, flush=True)
        sys.exit(128 + error.signum)
    except (ValueError, OSError, KeyError, EOFError) as error:
        print('vg-resources: ' + str(error), file=sys.stderr)
        sys.exit(1)
